name: ATS 2.0 Integration Test Pipeline

on:
  push:
    branches: [ "main" ]
  workflow_dispatch:

jobs:
  build-and-trigger-ats:
    runs-on: self-hosted

    steps:
      - name: 1. Checkout 程式碼
        uses: actions/checkout@v4

      - name: 2. 打包 Mobly 測試套件
        run: |
          zip -r test-suite.zip ./tests config.yaml

      - name: 3. 部署至 ATS Storage (從 GitHub Variables 讀取路徑)
        run: |
          # 🌟 從 GitHub 變數動態讀取，程式碼中完全不帶有敏感帳號名稱
          ATS_STORAGE="${{ vars.ATS_STORAGE_PATH }}"
          
          if [ -z "$ATS_STORAGE" ]; then
            echo "❌ 錯誤：未在 GitHub 網頁設定 ATS_STORAGE_PATH 變數！"
            exit 1
          fi

          mkdir -p "$ATS_STORAGE"
          cp test-suite.zip "$ATS_STORAGE/test-suite-${{ github.sha }}.zip"
          
          # 開通該資料夾權限
          chmod -R 777 "$ATS_STORAGE"
          echo "✅ 已成功寫入至 $ATS_STORAGE/test-suite-${{ github.sha }}.zip"

      - name: 4. 呼叫 ATS API
        run: |
          ATS_API_URL="http://localhost:8000"
          
          curl -f -sS -X POST "${ATS_API_URL}/v1/testRuns" \
            -H "Content-Type: application/json" \
            -d '{
              "name": "CI Run - Commit '${{ github.sha }}'",
              "test_suite_id": "tab_a8_sanity_suite",
              "test_resources": [
                {
                  "name": "test_suite_zip",
                  "path": "ci_builds/test-suite-'${{ github.sha }}'.zip"
                }
              ]
            }'
